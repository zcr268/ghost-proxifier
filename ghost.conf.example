# Ghost Proxifier config example
# Put this file as ghost.conf next to ghost-proxifier.exe and ghost_core.dll.

[global]
# HTTP CONNECT (default):
# proxy=127.0.0.1:2080
# SOCKS5 (no-auth) is also supported:
proxy=socks5://127.0.0.1:7890
# or:
# proxy_type=socks5
# proxy=127.0.0.1:1080
process=Codex.exe

# Log file auto-cleanup for GUI mode. 0 disables rotation.
# When ghost-proxifier.log exceeds this size it is moved to ghost-proxifier.log.1
# and a new log file is started.
log_max_mb=10
# GUI mode: start silently in the system tray instead of opening the log window.
# Double-click the tray icon or right-click -> Open Logs to show it.
start_minimized_to_tray=on
# DNS handling:
# dns=proxy forwards DNS queries through the configured upstream proxy to dns_server.
# dns=system disables Ghost's DNS proxy and uses the process/system DNS directly.
dns=system
dns_server=8.8.8.8:53
# IPv6/AAAA is enabled by default.
# Set dns_ipv6=off if your network has no working IPv6 and AAAA fallback is slow.
dns_ipv6=on
# IPv6 TCP connect handling: proxy=forward via upstream proxy, direct=let system handle it, fail=fast fail.
ipv6_connect=proxy

# Direct connection rules: use normal LAN/VPN route instead of HTTP CONNECT/SOCKS5 proxy.
# Local loopback is direct by default so the app can still talk to local services.
direct_domain=local
direct_domain=localhost
direct_domain=cli-proxy-api-latest-e774.onrender.com
direct_domain=*.github.com
direct_domain=github.com

direct_ip=127.0.0.1
# direct_domain=*.corp.example.com
# direct_domain=intranet.local
# direct_ip=172.16.0.0/12
direct_ip=192.168.0.0/16
direct_ip=198.18.0.1/16

# Optional per-process override.
# [process:Code.exe]
# proxy=127.0.0.1:2081
# direct_domain=api.internal.test
# direct_ip=192.168.50.0/24
